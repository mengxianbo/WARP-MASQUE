#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/usque
CONFIG=/etc/config/warp-masque
RUNDIR=/var/run/warp-masque
DATADIR=/etc/warp-masque
CONFIG_JSON=/etc/warp-masque/config.json

get_option() {
	uci -q get "warp-masque.main.$1"
}

start_service() {
	[ "$(get_option enabled)" = "1" ] || return 0

	local bind socks_port http_port
	bind="$(get_option bind)"
	socks_port="$(get_option socks_port)"
	http_port="$(get_option http_port)"
	[ -n "$bind" ] || bind="127.0.0.1"
	[ -n "$socks_port" ] || socks_port="32500"
	[ -n "$http_port" ] || http_port="32511"

	mkdir -p "$RUNDIR" "$DATADIR"
	chmod 700 "$DATADIR"

	# Registration is performed once; the account/device config is persisted.
	if [ ! -s "$CONFIG_JSON" ]; then
		logger -t warp-masque "No account config found; registering a WARP MASQUE device"
		"$PROG" -c "$CONFIG_JSON" register >>"$RUNDIR/register.log" 2>&1 || {
			logger -t warp-masque "WARP registration failed; inspect $RUNDIR/register.log"
			return 1
		}
		chmod 600 "$CONFIG_JSON"
	fi

	procd_open_instance socks
	procd_set_param command "$PROG" -c "$CONFIG_JSON" socks -b "$bind" -p "$socks_port"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance http
	procd_set_param command "$PROG" -c "$CONFIG_JSON" http-proxy -b "$bind" -p "$http_port"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger warp-masque
}
